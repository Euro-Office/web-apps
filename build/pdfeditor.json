{
    "main": {
        "copy": {
            "help": [
                {
                    "expand": true,
                    "cwd": "../apps/pdfeditor/main/resources/help/",
                    "src": [
                        "**",
                        "!*_/**",
                        "!**/src/**"
                    ],
                    "dest": "$BUILD_ROOT/web-apps/apps/pdfeditor/main/resources/help/"
                }
            ],
            "localization": [
                {
                    "expand": true,
                    "cwd": "../apps/pdfeditor/main/locale/",
                    "src": "*",
                    "dest": "$BUILD_ROOT/web-apps/apps/pdfeditor/main/locale/"
                }
            ]
        }
    }
}
