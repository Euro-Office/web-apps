{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>Euro-Office/.github"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "apps/*/main/resources/help/**"
  ],
  "packageRules": [
    {
      "description": "Libraries shipped to browsers from build/node_modules (vendor.manifest.mjs): review every update, never automerge",
      "matchFileNames": ["build/package.json"],
      "matchPackageNames": [
        "backbone",
        "jquery",
        "jquery.browser",
        "monaco-editor",
        "requirejs",
        "requirejs-text",
        "socket.io-client",
        "underscore"
      ],
      "automerge": false
    }
  ]
}
